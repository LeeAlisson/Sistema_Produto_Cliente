{
  "name": "app/sistema-produto-cliente",
  "description": "Sistema de gerenciamento de produtos e clientes",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "setup": "php scripts/setup.php",
    "verify": "php scripts/verify.php",
    "smoke": "php scripts/smoke-test.php"
  }
}
